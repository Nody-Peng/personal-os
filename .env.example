# Local development (npm run db:local)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/personal_os
# Production: Supabase pooler URL, e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
PAYLOAD_SECRET=generate-a-long-random-string

# Optional, stricter CSRF guard: every public URL of the site, comma-separated.
# When set, only these origins (plus the Vercel host names and, in development,
# http://localhost:3000) may use the login cookie; saves from any other address
# are treated as logged out, so list every domain you open the site with.
# NEXT_PUBLIC_SERVER_URL=https://journal.example.com

# Production only: the daily Vercel Cron (/api/cron/daily) must send this as a
# bearer token, which Vercel does once it is set. At least 16 random characters.
# CRON_SECRET=

# Optional: cloud voices for read aloud in the e-book reader (/api/tts).
# Without them the reader uses the browser's own voices (free).
# Azure Speech: the Speech resource's key and region (e.g. eastasia).
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# Gemini TTS: an API key from Google AI Studio; the model is optional.
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Development only: answer cloud requests with a tone, to try the reader without keys.
# TTS_MOCK=1
